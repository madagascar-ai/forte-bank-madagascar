FORTE_API_KEY=change-this-local-key
FORTE_HOST=127.0.0.1
# Exact IPv4/IPv6 addresses, comma-separated; loopback remains allowed.
FORTE_ALLOWED_CLIENTS=
# api_key: the UI asks for the key. open: opening the page signs the browser in (jury API still
# needs X-API-Key). trusted_clients: same, only for FORTE_ALLOWED_CLIENTS. guest: any visitor uploads
# without a key and sees only their own jobs; history, benchmark and config stay behind the key.
FORTE_WEB_ACCESS=api_key
# Safety limits for keyless browser uploads (0 disables); X-API-Key uploads are not limited.
FORTE_UI_MAX_QUEUED=10
FORTE_UI_MAX_UPLOADS_PER_HOUR=60
FORTE_PORT=8000
FORTE_SAMPLE_FPS=5
# yolo (default): fine-tuned team weights with fixed classes, release detector-v2 (`make models` downloads it).
# world (YOLO-World) or yoloe (YOLOE-26): zero-shot text classes from config/detector.json.
FORTE_DETECTOR=yolo
FORTE_MODEL_PATH=models/detector-v2.pt
FORTE_DEVICE=auto
# Loopback, Docker service 'ollama', or a literal private/Tailscale IP of a team machine (no hostnames).
FORTE_OLLAMA_URL=http://127.0.0.1:11434
# One vision-capable model for reasoning, zones and the benchmark judge: a single model stays
# loaded on the GPU instead of swapping two. FORTE_ZONE_MODEL/FORTE_JUDGE_MODEL default to it.
FORTE_LLM_MODEL=gemma4:26b
# Vision model for automatic zones; defaults to FORTE_LLM_MODEL. Needed only if the LLM is text-only.
FORTE_ZONE_MODEL=
FORTE_LLM_ENABLED=true
# Door/safe open-closed and laptop on-off read by the local vision model from detector crops.
# Off by default until the benchmark shows a gain; bounded calls per video (AGENTS.md 2.4).
FORTE_OBJECT_STATES=false
# Vision model for states; defaults to FORTE_ZONE_MODEL, then FORTE_LLM_MODEL.
FORTE_STATES_MODEL=
FORTE_STATES_MAX_CALLS=120
FORTE_AUTO_ZONES=true
# Cashier absence: zone (default; also an empty workstation) or track (only when seen walking away).
FORTE_CASHIER_PRESENCE=zone
# Before zones and the journal: one label per track (money vs document), join broken tracks, drop reflections.
FORTE_TRACK_REPAIR=true
FORTE_JOB_TIMEOUT_SEC=285
FORTE_DATA_DIR=data
FORTE_CONFIG_DIR=config
# Offline benchmark (UI: «Бенчмарк»). Keep disabled while the jury checks the service.
FORTE_BENCHMARK_ENABLED=false
# Google Sheets link (shared by link) or a local CSV: file name, timestamp, verdict, comment.
FORTE_BENCHMARK_LABELS=
FORTE_BENCHMARK_VIDEOS=videos
# Local LLM that judges whether a found violation is the labelled one; defaults to FORTE_LLM_MODEL.
FORTE_JUDGE_MODEL=
