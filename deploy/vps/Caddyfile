madagascar-ai.team, www.madagascar-ai.team {
	encode gzip
	# Uploads up to the service limit (256 MB) plus multipart overhead.
	request_body {
		max_size 270MB
	}
	# The GPU machine (RTX 5090) on the team tailnet; the service listens only on this address.
	reverse_proxy 100.118.149.106:8000 {
		# A deploy restarts the service for a few seconds: keep retrying the connection instead of
		# answering the jury with 502. Requests whose connection never opened are safe to retry.
		lb_try_duration 30s
		lb_try_interval 250ms
		# Status polls are idempotent: retry them even if the old process dropped the connection.
		lb_retry_match {
			method GET HEAD
		}
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}
